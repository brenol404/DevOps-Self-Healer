# Provedor Padrão (Google Gemini) - Crie um arquivo .env e insira sua chave:
GEMINI_API_KEY=sua_chave_aqui

# Provedor LLM (google | openai | ollama) e modelo. Exemplos:
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# LLM_PROVIDER=openai  + OPENAI_API_KEY=sua_chave_openai_aqui
# LLM_PROVIDER=ollama  + LLM_MODEL=qwen3:8b  (100% local, sem chave)

# Webhook opcional (Slack/Discord) para avisar ao fim de cada ciclo:
# WEBHOOK_URL=https://...

# CI=true pula a aprovação humana (use em automação; sem rede de segurança):
# CI=false